---
import type { GetStaticPathsOptions, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ARTICLE_PAGE_SIZE, assetHref, getArticles, getLatestArticle, getTags, type Article } from "@/lib/content";

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(getArticles(), { pageSize: ARTICLE_PAGE_SIZE });
}

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
const tags = getTags();
const featured = getLatestArticle();
const isFirstPage = page.currentPage === 1;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const articleHref = (slug: string) => `${base}articles/${slug}`;
const pageHref = (url?: string) => {
  if (!url) return undefined;
  const withSlash = url.endsWith("/") ? url : `${url}/`;
  return `${withSlash}#articles`;
};
const pageNumbers = Array.from({ length: page.lastPage }, (_, index) => index + 1);
const numberedPageHref = (pageNumber: number) =>
  pageNumber === 1 ? `${base}#articles` : `${base}${pageNumber}/#articles`;
---

<BaseLayout title="Mind-OS Public" description="Mind-OS 公开文章、讨论和知识工作流记录。">
  {isFirstPage && (
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Public knowledge layer</p>
        <h1>把个人知识系统里想清楚的部分，发布成可以被讨论和复用的文章。</h1>
        <p class="lead">
          这里不是私人 vault 的镜像，而是经过筛选、脱敏和整理后的公开内容层。正文保留在 Markdown，讨论沉淀到 GitHub Issues。
        </p>
        <div class="hero-actions">
          <a class="button primary" href={featured ? articleHref(featured.frontmatter.slug) : "#articles"}>阅读最新文章</a>
          <a class="button secondary" href="https://github.com/zhlkkk/mind-os-public/issues">参与讨论</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="内容流和微信公众号关注入口">
        <div class="flow-node warm">raw/publish</div>
        <div class="flow-line"></div>
        <div class="flow-node coral">content/articles</div>
        <div class="flow-line"></div>
        <div class="flow-node teal">GitHub Issues</div>
        <p>脱敏、同步、绑定讨论线程，让正文和反馈各司其职。</p>
        <div class="wechat-follow">
          <img src={`${base}wechat-qrcode.jpg`} alt="微信公众号二维码" loading="lazy" />
          <div>
            <strong>微信公众号</strong>
            <span>扫码关注，接收文章更新。</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section-band" id="articles">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Articles</p>
        <h2>{isFirstPage ? "最新公开内容" : `公开内容 · 第 ${page.currentPage} 页`}</h2>
      </div>
      <p class="section-meta">共 {page.total} 篇 · 第 {page.currentPage} / {page.lastPage} 页</p>
    </div>
    <div class="article-list">
      {page.data.map((article) => (
        <a class="article-row" href={articleHref(article.frontmatter.slug)}>
          <span class="date">{article.frontmatter.date}</span>
          {article.frontmatter.cover && (
            <span class="article-cover" aria-hidden="true">
              <img src={assetHref(article.frontmatter.cover)} alt="" loading="lazy" />
            </span>
          )}
          <span class="article-main">
            <strong>
              {article.frontmatter.pinned && <span class="pin-badge">置顶</span>}
              {article.frontmatter.title}
            </strong>
            <small>{article.frontmatter.summary}</small>
          </span>
          <span class="read-time">{article.readingMinutes} 分钟</span>
        </a>
      ))}
    </div>
    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {page.url.prev ? (
          <a class="button compact secondary" href={pageHref(page.url.prev)}>上一页</a>
        ) : (
          <span class="button compact secondary pagination-disabled" aria-disabled="true">上一页</span>
        )}
        <ol class="pagination-pages">
          {pageNumbers.map((pageNumber) => {
            const href = numberedPageHref(pageNumber);
            const isCurrent = pageNumber === page.currentPage;

            return (
              <li>
                {isCurrent ? (
                  <span class="pagination-page is-current" aria-current="page">{pageNumber}</span>
                ) : (
                  <a class="pagination-page" href={href}>{pageNumber}</a>
                )}
              </li>
            );
          })}
        </ol>
        {page.url.next ? (
          <a class="button compact secondary" href={pageHref(page.url.next)}>下一页</a>
        ) : (
          <span class="button compact secondary pagination-disabled" aria-disabled="true">下一页</span>
        )}
      </nav>
    )}
  </section>

  {isFirstPage && (
    <section class="tag-cloud" aria-label="主题标签">
      <p class="eyebrow">Signals</p>
      <div>
        {tags.map((tag, index) => <span class={`tag tone-${(index % 5) + 1}`}>{tag}</span>)}
      </div>
    </section>
  )}
</BaseLayout>
